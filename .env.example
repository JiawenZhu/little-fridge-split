# Server-side only. Never put these in the web page or the iOS app.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional partner attribution (BN code) for platform calls
PAYPAL_BN_CODE=
# From the webhook you register for /webhooks/paypal
PAYPAL_WEBHOOK_ID=
# Leave ORGANIZER_MERCHANT_ID empty to pay the account that owns the REST app. Setting it pays another merchant,
# which needs PayPal partner approval. ORGANIZER_VENMO (optional) is the Venmo handle for the free link.
ORGANIZER_MERCHANT_ID=
ORGANIZER_VENMO=
PORT=8787
