# Server-side only. Never put these in the web page or the iOS app.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional partner attribution (BN code) for platform calls
PAYPAL_BN_CODE=
# From the webhook you register for /webhooks/paypal
PAYPAL_WEBHOOK_ID=
# The demo organizer: a sandbox business account's merchant ID, and (optional) a Venmo handle for the free link
ORGANIZER_MERCHANT_ID=
ORGANIZER_VENMO=
PORT=8787
