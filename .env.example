# Server-side only. Never put these in the web page or the iOS app.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional partner attribution (BN code) for platform calls
PAYPAL_BN_CODE=
# From the webhook you register for /webhooks/paypal
PAYPAL_WEBHOOK_ID=
# Leave ORGANIZER_MERCHANT_ID empty to pay the account that owns the REST app. Setting it pays another merchant,
# which needs PayPal partner approval. ORGANIZER_VENMO (optional) is the Venmo handle for the free link.
ORGANIZER_MERCHANT_ID=
ORGANIZER_VENMO=
PORT=8787
# Public base URL for PayPal return links (defaults to the request host)
PUBLIC_URL=
# Second PayPal app with Transaction Search, Invoicing and Payouts turned on (Little Wallet's PayPal features)
ALT_CLIENT_ID=
ALT_CLIENT_SECRET=
ALT_BN_CODE=
# From: node --env-file=.env server/register-webhook.mjs https://your-public-host
ALT_WEBHOOK_ID=
# A long random string, the same one the Little Wallet app sends (its Config/Secrets.xcconfig)
SPLIT_APP_KEY=
# Where splits and links are kept. Defaults to ./data; on Render it's the persistent disk.
DATA_DIR=
